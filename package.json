{
  "name": "@datacore-one/mcp",
  "version": "2.2.1",
  "description": "Datacore MCP server — The Software of You",
  "type": "module",
  "bin": {
    "datacore-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": {
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "release": "npm version ${VERSION:-patch} && npm publish --access public && npm install -g @datacore-one/mcp@$(node -p 'require(\"./package.json\").version')",
    "verify": "bash scripts/prepublish-verify.sh",
    "prepublishOnly": "bash scripts/prepublish-verify.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "^13.0.0",
    "js-yaml": "^5.0.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "packs"
  ],
  "keywords": [
    "mcp",
    "datacore",
    "knowledge",
    "journal",
    "second-brain",
    "productivity"
  ],
  "license": "MIT",
  "author": "Fair Data Society",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacore-one/datacore-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "qs": "^6.16.0"
  }
}
